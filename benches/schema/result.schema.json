{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Velyr benchmark result",
  "type": "object",
  "required": ["benchmark", "commit", "profile", "platform", "cpu", "memory", "rustc", "os", "timestamp", "metrics"],
  "additionalProperties": false,
  "properties": {
    "benchmark": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "cpu": { "type": "string" },
    "memory": { "type": "string" },
    "rustc": { "type": "string" },
    "os": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "load_average": {
      "description": "1, 5 and 15 minute load average when the run started (optional: older baselines lack it).",
      "type": "array",
      "items": { "type": "number", "minimum": 0 },
      "minItems": 3,
      "maxItems": 3
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "number", "minimum": 0 }
    }
  }
}
